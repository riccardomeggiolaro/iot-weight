# Copia questo file in .env e modifica i valori

# Immagine da usare (registry privato GitHub) e versione (latest o es. 3.0.5)
IOT_WEIGHT_IMAGE=ghcr.io/riccardomeggiolaro/iot-weight
IOT_WEIGHT_TAG=latest

# Fuso orario del container
TZ=Europe/Rome

# Cartelle persistenti sull'host
# - config.json e service.log
IOT_WEIGHT_CONFIG_DIR=/etc/iot-weight
# - database, pdf, csv, immagini, backup
IOT_WEIGHT_DATA_DIR=/var/opt/iot-weight
# - configurazione stampanti CUPS
IOT_WEIGHT_CUPS_DIR=/etc/iot-weight/cups

# CUPS dentro il container (1 = attivo, 0 = disattivo)
CUPS_ENABLED=1
# Credenziali per l'interfaccia web di CUPS (http://<host>:631)
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASSWORD=cambiami
